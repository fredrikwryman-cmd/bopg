---
import Layout from '../layouts/Layout.astro';
import { company } from '../data/company.js';
import Navbar from '../components/layout/Navbar.jsx';
import Footer from '../components/layout/Footer.jsx';
import PageHeader from '../components/pages/PageHeader.jsx';
import ContactSection from '../components/contact/ContactSection.jsx';
---

<Layout
  title={`Kontakt | ${company.legalName}`}
  description={`Kontakta ${company.name} i Åkersberga. Berätta om ditt projekt så återkommer vi med en offert så snart vi kan.`}
>
  <Navbar client:idle />
  <main>
    <PageHeader
      client:load
      eyebrow="Kontakt"
      title="Kontakta oss"
      subtitle="Berätta om ditt projekt så återkommer vi inom kort."
      crumbs={[{ label: 'Kontakt' }]}
    />
    {/* showHeading={false}: PageHeader ovanför visar redan eyebrow "Kontakt",
        rubriken och samma ingress. Utan flaggan renderades hela
        blocket två gånger i rad — först mörkt, sedan ljust. */}
    <ContactSection client:visible showHeading={false} subject="Ny förfrågan från byggoprojektgruppen.se (Kontakt)" />
  </main>
  <Footer />
</Layout>
