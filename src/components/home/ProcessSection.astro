---
// SÅ JOBBAR VI — fyra steg som en scrollstyrd berättelse.
//
// VARFÖR INTE FYRA KOLUMNER. Den gamla layouten visade alla fyra stegen
// samtidigt i var sin smal spalt. Fyra parallella textblock läses inte som en
// ordning utan som en meny: ögat väljer ett av dem, och själva poängen — att
// det här är en kedja där varje steg förutsätter det förra — går förlorad.
// Ett steg i taget, framdrivet av scrollen, säger samma sak i rätt ordning.
//
// STRUKTUREN ÄR MEDVETET DEN SAMMA SOM I CompaniesSection.astro: spår + sticky
// scen, GSAP matchMedia, klassen `is-enhanced`, cleanup med clearProps. Två
// scrollstyrda sektioner på samma sida ska inte vara byggda på två olika sätt.
// Sektionen har ingen egen padding (den ligger på scenen) så att sektionens box
// är exakt spårets och ScrollTriggerns start/end sammanfaller med sticky-fasen.
//
// GRUNDTILLSTÅNDET ÄR ALLA FYRA STEGEN. Ingen opacity: 0 och ingen absolut
// positionering i grund-CSS:en: utan JavaScript, vid minskad rörelse, på mobil
// och i korta fönster står stegen som en läsbar vertikal tidslinje.

const steps = [
  {
    n: '01',
    title: 'Förstudie & planering',
    text: 'Vi sätter projektets mål, omfattning, förutsättningar och beslutsvägar innan produktionen börjar.',
  },
  {
    n: '02',
    title: 'Budget & upphandling',
    text: 'Vi tar fram en tydlig kostnadsbild, jämför alternativ och hjälper till att upphandla rätt kompetens för varje del.',
  },
  {
    n: '03',
    title: 'Genomförande & samordning',
    text: 'Vi leder produktionen, samordnar entreprenörerna och ser till att rätt arbete utförs i rätt ordning.',
  },
  {
    n: '04',
    title: 'Kontroll & överlämning',
    text: 'Vi följer upp kvalitet, ekonomi och dokumentation fram till en trygg och tydlig överlämning.',
  },
];

const total = String(steps.length).padStart(2, '0');
---

<section class="process" id="process" data-process-section>
  <div class="process-track">
    <div class="process-stage">
      <div class="wrap process-grid">
        <div class="process-aside">
          <span class="sec-ey">Så jobbar vi</span>
          <h2 class="sec-h">Tryggt från offert<br />till överlämning</h2>
          <p class="sec-intro">
            Fyra steg, i ordning. Samma ansvariga kontakt genom hela kedjan —
            från första beslutsunderlag till dokumenterad överlämning.
          </p>

          <div class="process-progress" aria-hidden="true">
            <span class="process-count mono">
              <span data-process-count>01</span>
              <span class="process-count-sep">/</span>
              <span class="process-count-total">{total}</span>
            </span>
            <span class="process-bar"><span class="process-bar-fill"></span></span>
          </div>
        </div>

        <ol class="process-steps">
          {steps.map((s) => (
            <li class="process-step" data-process-step>
              <span class="ps-num mono" aria-hidden="true">{s.n}</span>
              <div class="ps-body">
                <h3 class="ps-title">{s.title}</h3>
                <p class="ps-text">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const section = document.querySelector('[data-process-section]');
  const steps = gsap.utils.toArray('[data-process-step]');

  if (section && steps.length > 1) {
    gsap.registerPlugin(ScrollTrigger);

    const countEl = section.querySelector('[data-process-count]');
    const mm = gsap.matchMedia();

    mm.add(
      {
        // Samma tre villkor som bolagssektionen: bredd, höjd och rörelsevilja.
        // Höjden är inte kosmetisk — scenen är 100svh och måste rymma
        // rubrikblock och steg utan att klippa dem i ett lågt fönster.
        desktop: '(min-width: 761px) and (min-height: 620px) and (prefers-reduced-motion: no-preference)',
      },
      ({ conditions }) => {
        if (!conditions.desktop) return;

        section.classList.add('is-enhanced');

        const last = steps.length - 1;
        // Samma dvala som i bolagsstacken: varje steg står still en tredjedel
        // av sitt intervall innan nästa tar vid. Utan den rör sig texten
        // konstant och hinner aldrig läsas.
        const DWELL = 0.34;

        const withDwell = (progress) => {
          const raw = progress * last;
          const step = Math.min(Math.floor(raw), last - 1);
          const t = raw - step;
          const moving = Math.min(1, Math.max(0, (t - DWELL) / (1 - DWELL)));
          return step + moving * moving * (3 - 2 * moving);
        };

        const update = (progress) => {
          const position = withDwell(progress);
          const activeIndex = Math.min(last, Math.max(0, Math.round(position)));

          steps.forEach((step, index) => {
            const distance = index - position;
            // DJUPET: rubriken flyttar sig kortare sträcka än brödtexten.
            // Skillnaden är liten (0.62 mot 1.0) men det är just den som gör
            // att blocket läses som ett lager med djup i stället för som en
            // bild som skjuts i sidled.
            const shift = distance * 46;

            gsap.set(step, {
              autoAlpha: Math.abs(distance) > 0.999 ? 0 : 1 - Math.min(1, Math.abs(distance)),
              y: shift,
              zIndex: steps.length - index,
              pointerEvents: index === activeIndex ? 'auto' : 'none',
            });
            gsap.set(step.querySelector('.ps-title'), { y: shift * -0.38 });
            gsap.set(step.querySelector('.ps-num'), { y: shift * -0.62 });

            step.classList.toggle('is-active', index === activeIndex);
          });

          const label = String(activeIndex + 1).padStart(2, '0');
          section.style.setProperty('--active-step', label);
          section.style.setProperty('--process-progress', String(progress));
          if (countEl) countEl.textContent = label;
        };

        const trigger = ScrollTrigger.create({
          trigger: section,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.7,
          invalidateOnRefresh: true,
          onUpdate: (self) => update(self.progress),
        });

        update(0);

        return () => {
          trigger.kill();
          section.classList.remove('is-enhanced');
          section.style.removeProperty('--active-step');
          section.style.removeProperty('--process-progress');
          if (countEl) countEl.textContent = '01';

          steps.forEach((step) => {
            step.classList.remove('is-active');
            gsap.set([step, step.querySelector('.ps-title'), step.querySelector('.ps-num')], {
              clearProps: 'all',
            });
          });
        };
      },
    );

    // MOBIL OCH REDUCERAD RÖRELSE. Ingen sticky scen och ingen scrollstyrning —
    // bara en diskret intoning när varje steg kommer in i vyn. Stegen är fullt
    // synliga i grundläget; klassen är det enda som döljer dem, och den sätts
    // bara här.
    mm.add(
      { mobil: '(max-width: 760px) and (prefers-reduced-motion: no-preference)' },
      ({ conditions }) => {
        if (!conditions.mobil || !('IntersectionObserver' in window)) return;

        section.classList.add('is-timeline');

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0 },
        );
        steps.forEach((s) => io.observe(s));

        return () => {
          io.disconnect();
          section.classList.remove('is-timeline');
          steps.forEach((s) => s.classList.remove('is-in'));
        };
      },
    );
  }
</script>

<style>
  /* ---------- skal ---------- */
  .process {
    position: relative;
    background: var(--paper-2);
  }
  .process-track {
    position: relative;
  }
  .process-stage {
    position: relative;
    overflow: hidden;
    padding: clamp(4.5rem, 9vw, 7rem) 2rem;
  }

  .process-grid {
    width: 100%;
  }

  .process-aside {
    max-width: 34rem;
  }
  /* Mindre än sajtens .sec-h. Vänsterspalten är ca 530 px bred i scenen, och
     vid 3.4rem bröts rubriken i fyra korta stumpar ("TRYGGT FRÅN / OFFERT /
     TILL / ÖVERLÄMNING"). Vid den här graden ryms den på de två rader
     radbrytningen i markupen är satt för. */
  .process-aside .sec-h {
    font-size: clamp(1.75rem, 3.3vw, 2.65rem);
    line-height: 1.04;
  }

  /* ---------- progressindikator ----------
     Hör till den scrollstyrda scenen. I tidslinjeläget står alla fyra stegen
     framme samtidigt och det finns inget aktivt steg att räkna. */
  .process-progress {
    display: none;
  }

  /* ---------- stegen: grundtillstånd = vertikal tidslinje ----------
     Den hårfina linjen till vänster binder ihop stegen till en kedja. Den är
     ritad med en gradient på listan i stället för som ett eget element, så att
     den inte kan hamna i otakt med innehållet. */
  .process-steps {
    list-style: none;
    margin-top: clamp(2.4rem, 4.5vw, 3.2rem);
    display: grid;
    gap: clamp(1.8rem, 4vw, 2.6rem);
  }

  .process-step {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1rem, 2.4vw, 1.6rem);
    align-items: start;
  }

  .ps-num {
    font-size: .78rem;
    letter-spacing: .2em;
    color: var(--blue);
    padding-top: .35em;
    position: relative;
  }
  /* Tidslinjens streck: en kort linje under varje nummer, utom det sista. */
  .process-step:not(:last-child) .ps-num::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 2.2em;
    bottom: calc(-1 * clamp(1.8rem, 4vw, 2.6rem) - .4em);
    width: 1px;
    background: linear-gradient(var(--gold), rgba(184, 146, 74, 0));
  }

  .ps-title {
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    text-transform: uppercase;
    letter-spacing: -.008em;
    line-height: 1.1;
    color: var(--ink);
  }
  .ps-text {
    margin-top: .6rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--slate);
    max-width: 34rem;
  }

  /* ---------- SCENLÄGET (klassen sätts av GSAP matchMedia) ---------- */

  .process.is-enhanced .process-track {
    /* 240svh: 100 för scenen plus 140 att scrolla igenom. Med fyra steg ger det
       knappt halva skärmhöjden per steg — tillräckligt för att läsa, för lite
       för att kännas som en tunnel. Direktivets spann är 220–260. */
    height: 240vh;
    height: 240svh;
  }
  .process.is-enhanced .process-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    align-items: center;
    padding-block: clamp(2rem, 5vh, 4rem);
  }
  .process.is-enhanced .process-grid {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    gap: clamp(2.2rem, 5vw, 5rem);
    align-items: center;
  }

  .process.is-enhanced .process-progress {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(1.8rem, 3.5vw, 2.6rem);
  }
  .process-count {
    font-size: .78rem;
    letter-spacing: .18em;
    color: var(--ink);
    display: inline-flex;
    gap: .45em;
  }
  .process-count-sep,
  .process-count-total {
    color: var(--muted);
  }
  .process-bar {
    position: relative;
    flex: 1 1 auto;
    max-width: 12rem;
    height: 1px;
    background: var(--line);
    overflow: hidden;
  }
  .process-bar-fill {
    position: absolute;
    inset: 0;
    background: var(--gold);
    transform-origin: left center;
    /* Ingen transition: scrub sköter utjämningen, och en transition ovanpå den
       hade bara laggat efter scrollen. */
    transform: scaleX(var(--process-progress, 0));
  }

  /* Stegen läggs i samma rutnätscell — ett i taget syns. Ingen absolut
     positionering: cellen blir exakt så hög som det högsta steget. */
  .process.is-enhanced .process-steps {
    display: grid;
    gap: 0;
    margin-top: 0;
  }
  .process.is-enhanced .process-step {
    grid-area: 1 / 1;
    align-items: start;
    will-change: transform, opacity;
  }
  /* Tidslinjens streck hör till listläget. I scenen visas ett steg i taget och
     ett streck ned mot nästa skulle peka på ingenting. */
  .process.is-enhanced .ps-num::after {
    display: none;
  }
  .process.is-enhanced .ps-num {
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    font-weight: 700;
    letter-spacing: -.02em;
    line-height: 1;
    padding-top: 0;
    color: var(--gold);
    /* Siffran är stor men får inte konkurrera med rubriken om uppmärksamheten. */
    opacity: .34;
  }
  .process.is-enhanced .ps-title {
    font-size: clamp(1.7rem, 3.2vw, 2.5rem);
  }
  .process.is-enhanced .ps-text {
    margin-top: 1rem;
    font-size: 1.06rem;
    line-height: 1.75;
  }

  /* ---------- TIDSLINJELÄGET (mobil) ----------
     Diskret intoning när steget kommer in i vyn. Grundtillståndet är synligt;
     klassen is-timeline — som bara ett körande script sätter — är det som ger
     startläget, och is-in tonar in. */
  .process.is-timeline .process-step {
    opacity: 0;
    transform: translateY(20px);
  }
  .process.is-timeline .process-step.is-in {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--dur-enter) var(--ease),
      transform var(--dur-enter) var(--ease);
  }

  /* ---------- responsivt ---------- */
  @media (max-width: 600px) {
    .process-stage {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }
  }

  /* ---------- reducerad rörelse ----------
     matchMedia armar varken scenen eller tidslinjen vid reduce. Reglerna ligger
     kvar som spärr ifall klasserna sätts på annat sätt. */
  @media (prefers-reduced-motion: reduce) {
    .process.is-enhanced .process-track { height: auto; }
    .process.is-enhanced .process-stage {
      position: static;
      height: auto;
      display: block;
      padding-block: clamp(4.5rem, 9vw, 7rem);
    }
    .process.is-enhanced .process-steps {
      gap: clamp(1.8rem, 4vw, 2.6rem);
      margin-top: clamp(2.4rem, 4.5vw, 3.2rem);
    }
    .process.is-enhanced .process-step {
      grid-area: auto;
      transform: none !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
    .process.is-enhanced .process-progress { display: none; }
    .process.is-timeline .process-step {
      opacity: 1;
      transform: none;
    }
  }
</style>
