---
// VÅRA BOLAG — startsidans gruppsektion.
//
// EDITORIAL LISTA, INTE KORT. Fyra bolag ska läsas som fyra delar av EN grupp,
// och då är en radlista rätt form: gemensamma hårfina linjer binder ihop dem,
// medan fyra vita boxar delar upp dem i fyra separata objekt. All tyngd ligger
// i typografi, luft och proportioner — ingen ram, ingen skugga, ingen fylld
// yta.
//
// BYGGD SOM .astro, INTE SOM REACT-Ö MED FRAMER MOTION. whileInView kräver
// initial={{ opacity: 0 }}, och det serverrenderar `style="opacity:0"` rakt in
// i HTML:en — samma fel som redan finns på sajten (22 element osynliga utan
// JS). Mönstret här är i stället samma som BrandLogo.astro: ren markup + CSS
// som grundtillstånd, och ett litet script som lägger på rörelsen.
//
// GRUNDTILLSTÅNDET ÄR SYNLIGT. Raderna har full opacity i CSS. Först när
// scriptet kört sätts klassen `is-js` på sektionen — och det är den klassen,
// inte markupen, som döljer raderna inför intoningen. Utan JS finns klassen
// aldrig, och sektionen ser helt normal ut.
//
// Scriptet ligger som inline-modul i samma fil och körs under parsningen, före
// första målningen, så ingen blixt av synliga rader hinner visas.

import { company } from '../../data/company.js';
const companies = [
  {
    name: 'AD Byggprojekt',
    text: 'Entreprenad — nybyggnation, renovering, totalentreprenad. Systerbolag till oss.',
    // Sätt `url` här när adressen är permanent. Raden blir då en <a> som
    // helhet och pilen tänds — ingen strukturändring krävs.
    url: null,
    badge: 'Länk tillkommer',
  },
  {
    name: 'Bolag 02',
    text: 'CM-uppdrag inom specialitet som ännu inte är fastställd.',
    url: null,
    badge: 'Sajt under uppbyggnad',
  },
  {
    name: 'Bolag 03',
    text: 'CM-uppdrag inom specialitet som ännu inte är fastställd.',
    url: null,
    badge: 'Sajt under uppbyggnad',
  },
  {
    name: 'Bolag 04',
    text: 'CM-uppdrag inom specialitet som ännu inte är fastställd.',
    url: null,
    badge: 'Sajt under uppbyggnad',
  },
];
---

<section class="companies" id="bolag">
  <!-- Dekorativt ordmärke bakom listan. Rent visuellt: den riktiga rubriken är
       h2:an nedan, som alltid finns i DOM. -->
  <div class="companies-deco" aria-hidden="true">
    <span class="companies-deco-word">VÅRA BOLAG</span>
  </div>

  <div class="wrap companies-in">
    <span class="sec-ey">Gruppen</span>
    <h2 class="sec-h">Våra bolag</h2>
    <p class="sec-intro">
      {company.name} är navet i en grupp bolag som tillsammans täcker
      hela kedjan — från byggherrens första idé till färdig överlämning.
    </p>

    <ul class="companies-list">
      {companies.map((c, i) => {
        // Samma layout oavsett — bara elementet byts. Med url blir hela raden
        // en länk; utan url är den ren text, och pilen tonas ned så att
        // affordansen inte lovar något som inte finns.
        const Tag = c.url ? 'a' : 'div';
        const idx = String(i + 1).padStart(2, '0');
        return (
          <li class="company-item" style={`--i:${i}`}>
            <Tag
              class:list={['company-row', { 'is-pending': !c.url }]}
              {...(c.url ? { href: c.url } : {})}
            >
              <span class="company-idx mono">{idx}</span>
              <h3 class="company-name">{c.name}</h3>
              <span class="company-arrow" aria-hidden="true">&rarr;</span>
              <span class="company-meta">
                <span class="company-text">{c.text}</span>
                <span class="company-status mono">{c.url ? 'Till sajten' : c.badge}</span>
              </span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  // Progressiv förbättring. Allt här är tillägg — utan det här scriptet är
  // sektionen fullt läsbar, bara utan rörelse.
  const section = document.querySelector('.companies');

  if (section) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      // Klassen som slår om raderna till dolt starttillstånd. Sätts synkront
      // under parsningen, alltså före första målningen — därför hinner inga
      // synliga rader blinka förbi.
      section.classList.add('is-js');

      const reveal = () => section.classList.add('is-in');

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              reveal();
              io.disconnect();
            });
          },
          // threshold mäts mot sektionens EGEN höjd, inte mot skärmen. Ett
          // ratio-värde blir därför olika mycket scrollning på olika skärmar.
          // threshold 0 + negativ nedre rootMargin utlöser i stället när
          // sektionens överkant passerat 12 % upp i vyn, vilket är samma
          // upplevelse oavsett sektionshöjd och skärmstorlek.
          { rootMargin: '0px 0px -12% 0px', threshold: 0 },
        );
        io.observe(section);
      } else {
        // Utan IntersectionObserver: visa direkt hellre än att riskera att
        // raderna aldrig tonar in.
        reveal();
      }

      // Parallax på det dekorativa ordmärket. Håller sig medvetet inom
      // ±PARALLAX px — tillräckligt för att ordet ska halka efter listan,
      // för lite för att kännas som en effekt i sig.
      const deco = section.querySelector('.companies-deco-word');

      if (deco) {
        const PARALLAX = 34;
        let ticking = false;

        const update = () => {
          ticking = false;
          const r = section.getBoundingClientRect();
          const vh = window.innerHeight || document.documentElement.clientHeight;
          // Utanför vy: rör ingenting, och spar arbete.
          if (r.bottom < 0 || r.top > vh) return;
          // progress: 0 när sektionens överkant möter nederkanten av vyn,
          // 1 när sektionens underkant lämnat överkanten av vyn.
          const progress = (vh - r.top) / (vh + r.height);
          const offset = (progress - 0.5) * 2 * PARALLAX;
          deco.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
        };

        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        };

        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      }
    }
  }
</script>

<style>
  .companies {
    position: relative;
    overflow: hidden;
    padding: clamp(4.5rem, 9vw, 7rem) 2rem;
    background: var(--paper);
  }

  /* ---------- dekorativt ordmärke ---------- */
  .companies-deco {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    user-select: none;
    overflow: hidden;
  }
  .companies-deco-word {
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    white-space: nowrap;
    font-size: clamp(4rem, 15vw, 13rem);
    line-height: 1;
    /* Svag ton mot papper — ska kännas som en tryckt skugga i pappret, inte
       som text man försöker läsa. Sänkt från 0.055 i kortversionen: korten
       hade en egen vit yta som skärmade av ordet, medan listans text nu
       ligger direkt ovanpå det. Kontrollerat i vy — vid 0.055 skar ordets
       kanter genom brödtexten på rad 02. */
    color: rgba(34, 42, 51, 0.03);
    will-change: transform;
  }

  /* ---------- innehåll ---------- */
  .companies-in {
    position: relative;
    z-index: 1;
  }

  /* ---------- bolagslistan ----------
     Hårfina linjer, ingen fylld yta. En linje ovanför varje rad plus en
     avslutande under den sista ger en sammanhållen uppställning snarare än
     fyra fristående objekt. */
  .companies-list {
    list-style: none;
    margin-top: clamp(2.4rem, 4.5vw, 3.6rem);
    border-block-end: 1px solid var(--line);
  }

  .company-row {
    display: grid;
    grid-template-columns: clamp(3rem, 5.5vw, 5rem) minmax(0, 1fr) auto;
    grid-template-areas:
      'idx name arrow'
      '.   meta meta';
    align-items: start;
    column-gap: clamp(0.7rem, 1.8vw, 1.5rem);
    row-gap: clamp(0.55rem, 1.1vw, 0.85rem);
    padding-block: clamp(1.9rem, 3.4vw, 3rem);
    border-block-start: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .company-row:hover {
    border-block-start-color: rgba(34, 42, 51, 0.26);
  }
  .company-row:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }

  .company-idx {
    grid-area: idx;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--blue);
    /* Optisk linjering mot versalhöjden i bolagsnamnet bredvid. */
    padding-top: 0.5em;
    transition: color 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .company-row:hover .company-idx {
    color: var(--gold);
  }

  .company-name {
    grid-area: name;
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    /* Medvetet under .sec-h (clamp(2.2rem, 4.5vw, 3.4rem)) — sektionens
       rubrik ska förbli sidans röst, bolagsnamnen raden under den. */
    font-size: clamp(1.55rem, 3.4vw, 2.7rem);
    text-transform: uppercase;
    letter-spacing: -0.012em;
    line-height: 1.02;
    color: var(--ink);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .company-row:hover .company-name {
    transform: translateX(5px);
  }

  .company-arrow {
    grid-area: arrow;
    align-self: center;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1;
    color: var(--blue);
    transition:
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .company-row:hover .company-arrow {
    transform: translateX(6px);
  }
  /* Utan adress är raden ingen länk. Pilen finns kvar som riktningsmarkör i
     listan men tonas ned, och pekaren lovar ingenting. */
  .company-row.is-pending {
    cursor: default;
  }
  .company-row.is-pending .company-arrow {
    color: var(--muted);
    opacity: 0.42;
  }
  .company-row.is-pending:hover .company-arrow {
    opacity: 0.6;
  }

  .company-meta {
    grid-area: meta;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
    max-width: 34rem;
  }
  .company-text {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--slate);
  }
  .company-status {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .company-row:not(.is-pending) .company-status {
    color: var(--blue);
  }

  /* ---------- rörelse (endast med JS) ----------
     Grundtillståndet ovan är synligt. Först klassen .is-js — som bara ett
     körande script kan sätta — döljer raderna, och .is-in tonar in dem igen.
     Utan JS finns ingen av klasserna och raderna står kvar fullt synliga. */
  .companies.is-js .company-item {
    opacity: 0;
    transform: translateY(22px);
  }
  .companies.is-js.is-in .company-item {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    /* Staggad start: 90 ms mellan raderna. --i sätts per rad i markupen. */
    transition-delay: calc(var(--i) * 90ms);
  }

  /* ---------- responsivt ---------- */
  @media (max-width: 860px) {
    .companies-deco-word {
      font-size: clamp(3.2rem, 17vw, 7rem);
    }
  }

  /* Under 720 px ryms inte siffra, namn och pil på samma rad utan att namnet
     pressas ihop. Siffran flyttas då upp på egen rad — samma visuella idé,
     bara staplad. Fortfarande ingen box. */
  @media (max-width: 720px) {
    .company-row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'idx  idx'
        'name arrow'
        'meta meta';
      row-gap: 0.7rem;
    }
    .company-idx {
      padding-top: 0;
    }
  }

  @media (max-width: 600px) {
    .companies {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }
  }

  @media (max-width: 560px) {
    /* Det dekorativa ordet ryms inte på mobil utan att bli grötigt bakom
       texten — det tas bort helt i stället för att krympas till oläslighet. */
    .companies-deco {
      display: none;
    }
  }

  /* ---------- reducerad rörelse ----------
     Scriptet hoppar redan över både .is-js och parallaxen vid reduce, men
     reglerna ligger kvar som spärr ifall klassen sätts på annat sätt. Även
     hover-rörelsen stängs av; färgskiftet räcker som återkoppling. */
  @media (prefers-reduced-motion: reduce) {
    .companies.is-js .company-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .companies-deco-word {
      transform: none !important;
    }
    .company-row:hover .company-name,
    .company-row:hover .company-arrow {
      transform: none;
    }
  }
</style>
