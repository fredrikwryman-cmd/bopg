---
// Dekorativ roterande 3D-logo (mp4). INGEN keying: en rejäl mjuk radial vinjett-
// mask tonar videons kanter till transparent så den (1) döljer AI-vattenstämpeln
// i nedre högra hörnet och (2) löser upp videorutan så ingen rektangel syns.
// Sektionsbakgrunden är satt till videons uppmätta bakgrundston (#d4d4d4) så det
// som skymtar genom fade-zonen smälter ihop, och tonar sedan till paper nedåt.
// Reduced motion: stillbild (poster) i stället för spelande video.
//
// LADDNINGSSTRATEGI (mp4:an är 2,1 MB — startsidans i särklass tyngsta resurs):
// Videon har varken autoplay eller <source> i markupen. src sätts av scriptet
// nedan, och bara när BÅDA villkoren är uppfyllda:
//   1. viewporten är minst 768 px bred — på mobil visas enbart stillbilden och
//      mp4:an hämtas aldrig, och
//   2. sektionen är nära viewporten (IntersectionObserver).
// preload="metadata" räckte inte: attributet autoplay får webbläsaren att hämta
// hela filen ändå. På 1,6 Mbps tog de 2,1 MB ensamma ~10 s och svälte hero-bilden
// – sidans LCP-element – på bandbredd.
const BASE = import.meta.env.BASE_URL;
---

<section class="brand-video" aria-hidden="true">
  <div class="brand-video-inner">
    <video
      class="brand-video-media"
      muted
      loop
      playsinline
      webkit-playsinline
      preload="none"
      width="1280"
      height="720"
      data-src={BASE + 'logo-3d-rotating.mp4'}
      poster={BASE + 'logo-3d-rotating-poster.jpg'}
    ></video>
    <img
      class="brand-video-still"
      src={BASE + 'logo-3d-rotating-poster.jpg'}
      alt="Bygg & Projektgruppen"
      width="1280"
      height="720"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<script>
  // Samma mönster som systersajtens StopMotionBanner: uppspelningen startas av
  // scriptet i stället för av attributet autoplay, och filen hämtas först när
  // sektionen närmar sig viewporten. Tillägget här är mobilgrinden — under 768 px
  // får videon aldrig någon src alls, så mp4:an laddas inte ned över huvud taget.
  const DESKTOP = '(min-width: 768px)';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktop = window.matchMedia(DESKTOP);

  const videos = Array.prototype.slice.call(document.querySelectorAll('.brand-video-media'));

  // Sätter src (= startar nedladdningen) och spelar upp. Anropas bara när både
  // mobilgrinden och viewport-grinden släppt igenom.
  const start = (v) => {
    if (v.dataset.started === 'true') return;
    if (!desktop.matches) return;
    if (v.dataset.nearViewport !== 'true') return;
    v.dataset.started = 'true';
    // iOS/Android kräver muted + playsinline för uppspelning utan användargest.
    v.muted = true;
    v.defaultMuted = true;
    v.setAttribute('muted', '');
    v.src = v.dataset.src;
    v.load();
    const p = v.play();
    if (p && p.catch) p.catch(() => {});
  };

  videos.forEach((v) => {
    // Vid minskad rörelse visas stillbilden (se CSS) och videon rörs aldrig.
    if (reduced) return;

    if ('IntersectionObserver' in window) {
      // rootMargin ger klippet 300 px försprång så det hunnit börja spela när
      // sektionen rullas in. Observern kopplas bort efter första träffen.
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          v.dataset.nearViewport = 'true';
          start(v);
          io.disconnect();
        });
      }, { rootMargin: '300px 0px', threshold: 0 });
      io.observe(v);
    } else {
      // Utan IntersectionObserver faller vi tillbaka på att starta direkt —
      // mobilgrinden i start() gäller fortfarande.
      v.dataset.nearViewport = 'true';
      start(v);
    }

    // Växer fönstret förbi 768 px (rotation eller storleksändring) efter att
    // sektionen varit i vy, hämtas videon då i stället.
    const onChange = () => { if (desktop.matches) start(v); };
    if (desktop.addEventListener) desktop.addEventListener('change', onChange);
    else desktop.addListener(onChange);
  });
</script>

<style>
  .brand-video {
    /* Videons uppmätta bakgrundston (#d4d4d4) bakom videon så fade-zonen smälter
       ihop, tonande till paper (#F7F5F1) nedåt. Mörk hero ovanför som avsiktlig
       kontrast. */
    background: linear-gradient(to bottom, #d4d4d4 0%, #d4d4d4 62%, #F7F5F1 100%);
    padding: clamp(3.5rem, 8vw, 7rem) 1.5rem;
    display: flex;
    justify-content: center;
  }
  .brand-video-inner {
    width: 100%;
    max-width: clamp(320px, 78vw, 900px);
    margin: 0 auto;
  }
  .brand-video-media,
  .brand-video-still {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    /* Rejäl mjuk vinjett: helt opak över loggan (centralt), tonar till transparent
       långt innanför kanterna -> döljer vattenstämpeln (nedre höger) och löser upp
       rektangeln. Radie verifierad mot flera rotationsframes så loggan aldrig
       beskärs i någon vinkel. */
    -webkit-mask-image: radial-gradient(ellipse 47% 60% at 50% 47%, #000 60%, rgba(0, 0, 0, 0) 90%);
    mask-image: radial-gradient(ellipse 47% 60% at 50% 47%, #000 60%, rgba(0, 0, 0, 0) 90%);
  }
  /* Som standard: visa videon, dölj stillbilden. */
  .brand-video-still {
    display: none;
  }
  /* Reducerad rörelse: dölj videon, visa stillbilden. */
  @media (prefers-reduced-motion: reduce) {
    .brand-video-media {
      display: none;
    }
    .brand-video-still {
      display: block;
    }
  }
  /* Mobil (< 768 px): stillbilden i stället för videon. Speglar mobilgrinden i
     scriptet ovan, som ser till att mp4:an aldrig ens hämtas på små skärmar. */
  @media (max-width: 767px) {
    .brand-video-media {
      display: none;
    }
    .brand-video-still {
      display: block;
    }
  }
  @media (max-width: 600px) {
    .brand-video {
      padding-left: 1.1rem;
      padding-right: 1.1rem;
    }
    .brand-video-inner {
      max-width: 90vw;
    }
  }
</style>
