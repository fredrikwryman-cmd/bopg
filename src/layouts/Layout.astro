---
// Typsnitten levereras från sajten själv i stället för via en render-blockerande
// @import från fonts.googleapis.com i global.css. Den kedjan kostade ~780 ms på
// första målningen: webbläsaren tvingades hämta en extern stilmall innan den ens
// visste vilka typsnittsfiler den behövde. font-display: swap ingår i filerna.
// Endast latin-subsetet importeras — svenska å/ä/ö ryms där.
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/archivo/latin-900.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';

const {
  title = 'Bygg & Projektgruppen i Stockholm AB',
  description = 'Bygg och Projektgruppen i Stockholm AB — samlad byggpartner i Stockholm med bas i Åkersberga. Nybyggnation, renovering, entreprenad, el & VVS, mark, plåt och smide.',
  // Filnamn i public/ för sidans LCP-bild. Sätts bara av sidor som har en stor
  // bild direkt i första vyn (i dag startsidans hero) så att webbläsaren kan
  // börja hämta den direkt ur HTML:en, i stället för att först vänta in React-öns
  // hydrering. Sidor utan prop får ingen preload — en oanvänd preload kostar bara
  // bandbredd. srcset/sizes speglar <img>-taggens egna värden så att preloaden
  // väljer exakt samma kandidat som bilden själv gör.
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
} = Astro.props;

const preloadImageURL = preloadImage ? `${import.meta.env.BASE_URL}${preloadImage}` : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteRoot = new URL(import.meta.env.BASE_URL, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': siteRoot,
  name: 'Bygg och Projekt Gruppen i Stockholm AB',
  alternateName: 'Bygg & Projektgruppen',
  url: siteRoot,
  telephone: '+46704629943',
  email: 'Andreas@byggoprojektgruppen.se',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Sågvägen 33',
    postalCode: '184 40',
    addressLocality: 'Åkersberga',
    addressRegion: 'Stockholms län',
    addressCountry: 'SE',
  },
  areaServed: [
    { '@type': 'City', name: 'Stockholm' },
    { '@type': 'City', name: 'Åkersberga' },
  ],
  identifier: { '@type': 'PropertyValue', name: 'Organisationsnummer', value: '559576-5198' },
  founder: { '@type': 'Person', name: 'Andreas Berndt Dahlgren' },
};
---
<!DOCTYPE html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#222A33" />
    <!-- Sajten är ett arbetsprov i Fredriks portfölj, inte kundens skarpa sajt.
         Därför noindex på ALLA sidor — arbetsprovet får aldrig konkurrera med
         eller ranka före Bygg & Projektgruppens framtida riktiga webbplats.
         "follow" behålls så att utgående länkar fortfarande följs normalt. -->
    <meta name="robots" content="noindex, follow" />

    {preloadImageURL && (
      <link
        rel="preload"
        as="image"
        href={preloadImageURL}
        imagesrcset={preloadImageSrcset}
        imagesizes={preloadImageSizes}
        fetchpriority="high"
      />
    )}

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <title>{title}</title>

    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bygg & Projektgruppen" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
