---
// VÅRA BOLAG — fyra paneler i ett dragspel.
//
// FILNAMNET SÄGER ProjectGallery, SEKTIONEN HETER VÅRA BOLAG. Komponenten
// byggdes som ett projektgalleri och fick sedan bolagssektionens rubriker och
// plats. Dragspelet, bilderna, färgerna och timingen är oförändrade — det är
// bara texten ovanför och etiketterna på panelerna som är bolagens. Filen får
// gärna döpas om, men det är en egen ändring; här är ingenting annat rört.
//
// RUBRIKTEXTEN ÄR HÄMTAD ORDAGRANT ur den arkiverade bolagssektionen
// (src/_archive/bolagssektion/CompaniesSection.astro). Ändras den här ska den
// ändras där också, annars glider de isär den dag sektionen tas tillbaka.
//
// PLATSHÅLLARE, INTE PROJEKT. Bilderna i public/projekt/ är ritade lokalt ur
// sajtens egen palett: samma blueprint-rutnät som hero och sidhuvudena använder,
// samma ink-, blue- och gold-toner, ett spöknummer i samma anda som
// bolagskorten. Inga stockfoton och ingen extern bildtjänst — komponentens
// exempel pekar på picsum.photos, och en enda sådan URL hade gjort
// integritetspolicyn osann. Den räknar i dag upp exakt ett tredjepartsanrop
// (OpenStreetMap på kontaktsidan), och den meningen ska fortsätta stämma.
//
// INGEN LÄNK. Projektsidor finns inte, så panelerna får inget `link`. Då
// renderas de som <button> i stället för <a> — de öppnar en panel, de går
// ingenstans. En länk till # hade varit ett löfte utan täckning.
import AccordionGallery from '../AccordionGallery.jsx';
import { company } from '../../data/company.js';

// FYRA PANELER, INTE FEM. Navet listar sig inte självt: Bygg och Projekt
// Gruppen är avsändaren för hela sektionen och hör inte hemma som ett av
// korten i den. Bilderna är oförändrade — samma fyra platshållare i sajtens
// palett, bara namnen ovanpå är bolagens.
const bolag = [
  { image: '/projekt/projekt-01.png', label: 'AD Byggprojekt' },
  { image: '/projekt/projekt-02.png', label: 'Bolag 02' },
  { image: '/projekt/projekt-03.png', label: 'Bolag 03' },
  { image: '/projekt/projekt-04.png', label: 'Bolag 04' },
].map((b) => ({
  ...b,
  // Alt-texten säger vad bilden ÄR. Den påstår inte att det finns en logotyp
  // eller ett projektfoto att se — bilden är en platshållare, och det gäller
  // även för AD Byggprojekt.
  alt: `${b.label} — platshållarbild`,
}));
---

<section class="projects" id="bolag">
  <div class="wrap">
    <span class="sec-ey">Gruppen</span>
    <h2 class="sec-h">Våra bolag</h2>
    <p class="sec-intro">
      {company.name} är navet i en grupp bolag som tillsammans täcker
      hela kedjan — från byggherrens första idé till färdig överlämning.
    </p>

    <!-- grayscale av: komponenten avfärgar vilande paneler, men
         platshållarna är redan ritade i sajtens palett och blev bara gråa av
         det. Nedtoningen av de vilande panelerna sköts av overlayen i stället,
         så blått förblir blått.

         TIMINGEN. Panelerna ska snäppa, inte glida. Alla fyra panelerna
         animeras redan från position 0 i samma tidslinje, så de rör sig
         tillsammans — stagger rör bara etikettens två delar (linjen och
         texten) och la 60 ms på svansen. Den är nollad, så etiketten landar
         samtidigt som bredden. duration 0.45 med power4.out ger en kurva som
         är i stort sett framme långt före sitt slut. -->
    <div class="projects-stage">
      <AccordionGallery
        client:visible
        items={bolag}
        defaultIndex={0}
        expandRatio={0.58}
        gap={7}
        radius={0}
        height={520}
        ariaLabel="Våra bolag, fyra paneler"
        accentColor="var(--gold)"
        overlayColor="var(--ink)"
        textColor="var(--paper)"
        grayscale={false}
        duration={0.45}
        stagger={0}
        ease="power4.out"
      />
    </div>
  </div>
</section>

<style>
  .projects {
    /* Våra bolag slutar på paper. Den här sektionen tar paper-2 så att de två
       skiljs åt utan en linje emellan. */
    background: var(--paper-2);
    padding: clamp(4.5rem, 9vw, 7rem) 2rem;
  }

  .projects-stage {
    margin-top: clamp(2.4rem, 4.5vw, 3.2rem);
  }

  /* Panelerna är knappar. Sajtens fokusmarkering ska gälla även här — den
     inbyggda box-shadow-ringen i komponenten syns dåligt mot en mörk panel. */
  .projects-stage :global(.ag-panel:focus-visible) {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }

  @media (max-width: 600px) {
    .projects {
      padding-left: 1.3rem;
      padding-right: 1.3rem;
    }
  }
</style>
