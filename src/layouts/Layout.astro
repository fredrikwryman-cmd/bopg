---
// Typsnitten levereras från sajten själv i stället för via en render-blockerande
// @import från fonts.googleapis.com i global.css. Den kedjan kostade ~780 ms på
// första målningen: webbläsaren tvingades hämta en extern stilmall innan den ens
// visste vilka typsnittsfiler den behövde. font-display: swap ingår i filerna.
// Endast latin-subsetet importeras — svenska å/ä/ö ryms där.
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/archivo/latin-900.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';

import { company } from '../data/company.js';

const {
  title = company.legalName,
  description = `${company.legalName} — samlad byggpartner i Stockholm med bas i Åkersberga. Nybyggnation, renovering, entreprenad, el & VVS, mark, plåt och smide.`,
  // Filnamn i public/ för sidans LCP-bild. Sätts bara av sidor som har en stor
  // bild direkt i första vyn (i dag startsidans hero) så att webbläsaren kan
  // börja hämta den direkt ur HTML:en, i stället för att först vänta in React-öns
  // hydrering. Sidor utan prop får ingen preload — en oanvänd preload kostar bara
  // bandbredd. srcset/sizes speglar <img>-taggens egna värden så att preloaden
  // väljer exakt samma kandidat som bilden själv gör.
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
  // Arbetsprov på subdomän till aimstudios.se – får INTE indexeras. När kunden
  // lanserar på sin egen domän ska den sajten äga sin egen text i Google, inte
  // konkurrera med en kopia här. Sätt tillbaka 'index, follow' först om sajten
  // någon gång ska bo kvar på den här adressen på riktigt.
  robots = 'noindex, nofollow',
} = Astro.props;

const preloadImageURL = preloadImage ? `${import.meta.env.BASE_URL}${preloadImage}` : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteRoot = new URL(import.meta.env.BASE_URL, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  // ProfessionalService, inte GeneralContractor. Den gamla typen signalerar
  // utförande entreprenad, medan bolaget profileras som CM-konsult — byggherrens
  // rådgivare och samordnare. Typen är dessutom en förutsättning för geo nedan:
  // schema.org har ingen geo-egenskap på Organization, den ärvs från Place via
  // LocalBusiness. ProfessionalService är en underklass till LocalBusiness.
  '@type': 'ProfessionalService',
  '@id': siteRoot,
  name: company.legalName,
  legalName: company.legalName,
  alternateName: company.name,
  url: siteRoot,
  telephone: company.phoneHref.replace('tel:', ''),
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Sågvägen 33',
    postalCode: '184 40',
    addressLocality: 'Åkersberga',
    addressRegion: 'Stockholms län',
    addressCountry: 'SE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: company.latitude,
    longitude: company.longitude,
  },
  areaServed: [
    { '@type': 'City', name: 'Stockholm' },
    { '@type': 'City', name: 'Åkersberga' },
  ],
  identifier: { '@type': 'PropertyValue', name: 'Organisationsnummer', value: company.orgNr },
  founder: { '@type': 'Person', name: company.ceo },
};
---
<!DOCTYPE html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#222A33" />
    <!-- Noindex på ALLA sidor. Sajten crawlas fortfarande (robots.txt spärrar inte)
         så att Google faktiskt hinner läsa den här taggen – en spärrad adress kan
         annars hamna i indexet ändå, via en extern länk, som en tom träff. -->
    <meta name="robots" content={robots} />

    {preloadImageURL && (
      <link
        rel="preload"
        as="image"
        href={preloadImageURL}
        imagesrcset={preloadImageSrcset}
        imagesizes={preloadImageSizes}
        fetchpriority="high"
      />
    )}

    <!-- Favicon. Ingen SVG-variant: webbläsare som stödjer image/svg+xml
         föredrar den framför allt annat, och då syns aldrig ikonerna nedan.
         Den gamla platshållar-SVG:n ligger arkiverad i src/_archive/. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>

    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.legalName} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <!-- Sentinel för den fixerade headern. Ligger absolut positionerad i
         dokumentets överkant och tar ingen plats i flödet. När den lämnar vyn
         vet Navbar.jsx att sidan har scrollats, utan ett enda scroll-event. -->
    <div data-header-sentinel aria-hidden="true"></div>
    <slot />
  </body>
</html>
