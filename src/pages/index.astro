---
import Layout from '../layouts/Layout.astro';
import { company } from '../data/company.js';
import Navbar from '../components/layout/Navbar.jsx';
import Footer from '../components/layout/Footer.jsx';
import HeroSection from '../components/home/HeroSection.jsx';
import BrandVideo from '../components/home/BrandVideo.astro';
import CompaniesSection from '../components/home/CompaniesSection.astro';
import ProcessSection from '../components/home/ProcessSection.astro';
import AboutSection from '../components/home/AboutSection.jsx';
import ContactSection from '../components/contact/ContactSection.jsx';
---

<Layout
  title={`${company.legalName} | Samlad byggpartner i Åkersberga`}
  description={`${company.legalName} — samlad byggpartner i Stockholm med bas i Åkersberga. Nybyggnation, renovering, entreprenad, el & VVS, mark, plåt och smide.`}
  preloadImage="hero.jpg"
  preloadImageSrcset="/hero-800.jpg 800w, /hero.jpg 1400w"
  preloadImageSizes="100vw"
>
  <Navbar client:idle />
  <main>
    {/* client:idle, inte client:load — samma som systersajtens hero. Hero-bilden
        är sidans LCP-element och ligger redan färdig i serverrenderad HTML, men
        client:load lade hydreringen av React + framer-motion (ca 300 kB) före
        första målningen. Med 4x CPU-strypning band det huvudtråden i drygt fem
        sekunder innan bilden hann målas — LCP-mätningen visade 91 % "render
        delay". client:idle låter webbläsaren måla först och hydrera sedan. */}
    <HeroSection client:idle />
    <BrandVideo />
    <CompaniesSection />
    <ProcessSection />
    <AboutSection client:visible />
    <ContactSection client:visible />
  </main>
  <Footer />
</Layout>
